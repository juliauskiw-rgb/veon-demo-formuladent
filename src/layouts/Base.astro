---
import piazzollaPreload from '../assets/fonts/piazzolla-cyrillic-500-normal.woff2?url';
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/sections.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="data:," />
    <link rel="preload" href={piazzollaPreload} as="font" type="font/woff2" crossorigin data-rec="R-205" />
    <slot name="head" />
    <style is:global>html { overflow-x: clip; } body { overflow-x: clip; }</style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main" data-rec="R-213">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <slot name="after" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
